              "shortDescription": {
                "markdown": "CVE-2025-54121: Starlette has possible denial-of-service vector when parsing large files in multipart forms",
                "text": "CVE-2025-54121: Starlette has possible denial-of-service vector when parsing large files in multipart forms"
              }
            },
            {
              "deprecatedIds": [
                "CVE-2024-24762",
                "PYSEC-2024-38",
                "PYSEC-2026-1850",
                "GHSA-2jv5-9r88-3w3p",
                "GHSA-qf9m-vfgh-m389"
